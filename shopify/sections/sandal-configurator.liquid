{{ 'sandal-configurator.css' | asset_url | stylesheet_tag }}

{%- if section.settings.product != blank -%}
  {%- assign sc_product = all_products[section.settings.product] -%}
{%- elsif product -%}
  {%- comment -%} Fallback: sulla pagina prodotto usa il prodotto corrente. {%- endcomment -%}
  {%- assign sc_product = product -%}
{%- endif -%}

<div class="sandal-configurator-section" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="sandal-configurator-section__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="sandal-configurator" style="--sc-canvas-height: {{ section.settings.canvas_height }}px;">
    <div data-sc-canvas></div>
    <div data-sc-panel></div>
  </div>

  {%- render 'sandal-configurator-data', product: sc_product, section: section -%}
</div>

<script src="{{ 'sandal-configurator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Configuratore Sandalo 3D",
  "tag": "section",
  "class": "sandal-configurator-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Personalizza il tuo sandalo"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Prodotto configuratore",
      "info": "Il prodotto con le varianti a fasce di prezzo (es. Standard / Plus / Premium)."
    },
    {
      "type": "range",
      "id": "canvas_height",
      "label": "Altezza area 3D (px)",
      "min": 360,
      "max": 820,
      "step": 20,
      "default": 600
    },
    {
      "type": "text",
      "id": "model_filename",
      "label": "Nome file modello .glb (opzionale)",
      "info": "Es. sandal.glb (caricato negli asset del tema). Lascia vuoto per usare la geometria segnaposto."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Spazio sopra (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Spazio sotto (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 36
    }
  ],
  "presets": [{ "name": "Configuratore Sandalo 3D" }]
}
{% endschema %}
