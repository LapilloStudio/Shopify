{{ 'sandal-configurator.css' | asset_url | stylesheet_tag }}

{%- if section.settings.product != blank -%}
  {%- assign sc_product = all_products[section.settings.product] -%}
{%- elsif product -%}
  {%- comment -%} Fallback: sulla pagina prodotto usa il prodotto corrente. {%- endcomment -%}
  {%- assign sc_product = product -%}
{%- endif -%}

{%- comment -%}
  Il configuratore si apre come esperienza a schermo intero: sulla pagina compare
  solo un bottone; il 3D viene montato al primo click (nessun costo di rendering
  finché l'utente non apre davvero il configuratore).
{%- endcomment -%}
<div class="sandal-configurator-embed">
  <button type="button" class="sc-launcher" data-sc-open aria-haspopup="dialog">
    <span class="sc-launcher-icon" aria-hidden="true">◎</span>
    <span class="sc-launcher-text">
      <strong>{{ section.settings.heading | default: 'Configura il tuo sandalo' }}</strong>
      {%- if section.settings.subheading != blank -%}
        <span>{{ section.settings.subheading }}</span>
      {%- endif -%}
    </span>
  </button>

  <div
    class="sc-modal"
    data-sc-modal
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="{{ section.settings.heading | default: 'Configura il tuo sandalo' }}"
  >
    <button type="button" class="sc-modal-close" data-sc-close aria-label="Chiudi">&times;</button>
    <div
      class="sandal-configurator"
      {%- if section.settings.model_filename != blank %}
      data-model-url="{{ section.settings.model_filename | asset_url }}"
      {%- endif %}
    >
      <div data-sc-canvas></div>
      <div data-sc-panel></div>
    </div>
  </div>

  {%- render 'sandal-configurator-data', product: sc_product, section: section -%}
</div>

<script src="{{ 'sandal-configurator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Configuratore Sandalo 3D",
  "tag": "section",
  "class": "sandal-configurator-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo bottone",
      "default": "Configura il tuo sandalo"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sottotitolo (opzionale)",
      "default": "Scegli colori e tomaia in 3D"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Prodotto configuratore",
      "info": "Il prodotto con le varianti a fasce di prezzo (es. Standard / Plus / Premium)."
    },
    {
      "type": "text",
      "id": "model_filename",
      "label": "Nome file modello .glb (opzionale)",
      "info": "Es. sandal.glb (caricato negli asset del tema). Lascia vuoto per usare la geometria segnaposto."
    }
  ],
  "presets": [{ "name": "Configuratore Sandalo 3D" }]
}
{% endschema %}
